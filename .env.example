# Network Automation Service — environment configuration
#
# Copy to .env and adjust. Never commit .env.
#   cp .env.example .env
#
# Every variable is prefixed NAS_ and maps to a field on nas.core.config.Settings.

# ── Application ───────────────────────────────────────────────────────────────
# local | staging | production
NAS_ENVIRONMENT=local
NAS_SERVICE_NAME=nas

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
NAS_LOG_LEVEL=INFO
# json for deployed environments, console for readable local output
NAS_LOG_FORMAT=console

# ── Database (required) ───────────────────────────────────────────────────────
# Must use the asyncpg driver. Give NAS its own database and its own role — the
# ClientManager database user must have no access to it, and vice versa.
NAS_DATABASE_URL=postgresql+asyncpg://nas:nas@localhost:5434/nas_dev
NAS_DB_POOL_SIZE=5
NAS_DB_MAX_OVERFLOW=10
NAS_DB_ECHO=false

# ── Network access control ────────────────────────────────────────────────────
# Comma-separated IPs/CIDRs allowed to reach /api/v1. Health probes are exempt.
# Empty = allow any, permitted ONLY in local/test; the service refuses to start
# in staging/production without an allowlist.
# Example for staging: NAS_ALLOWED_IP_RANGES=10.20.30.40/32,10.20.31.0/24
NAS_ALLOWED_IP_RANGES=

# Set true ONLY when behind a reverse proxy you control that sets
# X-Forwarded-For. When false, forwarding headers are ignored entirely so a
# caller cannot spoof its source address past the allowlist.
NAS_TRUST_PROXY_HEADERS=false

# ── API surface ───────────────────────────────────────────────────────────────
# Swagger UI at /docs. Consider false in production.
NAS_DOCS_ENABLED=true
# Comma-separated browser origins. Leave empty — ClientManager calls this
# server-to-server and needs no CORS.
NAS_CORS_ALLOW_ORIGINS=

# ── Synchronisation ───────────────────────────────────────────────────────────
# Embedded scheduler. Set false to drive syncs from a systemd timer running
# `nas sync run` instead — matching how ClientManager schedules its own jobs.
NAS_SYNC_ENABLED=true
NAS_SYNC_INTERVAL_SECONDS=900

# Switches polled in parallel. Device I/O dominates a run's wall-clock.
NAS_SYNC_MAX_CONCURRENCY=4

# DANGER. When false (the default), a switch reporting zero VLANs while active
# records exist is treated as a failed read and its data is left untouched.
# Setting this true lets such a report mark every VLAN on that switch missing.
# Only enable if a switch genuinely has no VLANs.
NAS_SYNC_ALLOW_EMPTY_DISCOVERY=false

# After this long, a run still marked 'running' is assumed abandoned (process
# killed) and recorded as failed, so /sync/status stops reporting it in progress.
NAS_SYNC_STALE_RUN_MINUTES=60

# Device connection timeouts, in seconds.
NAS_DRIVER_CONNECT_TIMEOUT=30
NAS_DRIVER_COMMAND_TIMEOUT=60

# Verify device TLS certificates (Cisco NX-API only).
# Defaults false: Nexus switches ship self-signed certificates and NAS reaches them
# over a private management network, so verification would fail on essentially every
# device. Enable once the estate presents certificates NAS can validate.
NAS_DRIVER_VERIFY_TLS=false

# ── Device credentials ────────────────────────────────────────────────────────
# Path to the 0600-mode YAML file holding switch credentials. Switch secrets are
# NEVER stored in the database; the switches table holds only a credential name.
#   cp credentials.example.yaml credentials.yaml && chmod 600 credentials.yaml
NAS_CREDENTIALS_FILE=credentials.yaml
