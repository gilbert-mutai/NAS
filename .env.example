# Network Automation Service — environment configuration
#
# Copy to .env and adjust. Never commit .env.
#   cp .env.example .env
#
# Every variable is prefixed NAS_ and maps to a field on nas.core.config.Settings.

# ── Application ───────────────────────────────────────────────────────────────
# local | staging | production
NAS_ENVIRONMENT=local
NAS_SERVICE_NAME=nas

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
NAS_LOG_LEVEL=INFO
# json for deployed environments, console for readable local output
NAS_LOG_FORMAT=console

# ── Database (required) ───────────────────────────────────────────────────────
# Must use the asyncpg driver. Give NAS its own database and its own role — the
# CRM database user must have no access to it, and vice versa.
NAS_DATABASE_URL=postgresql+asyncpg://nas:nas@localhost:5434/nas_dev
NAS_DB_POOL_SIZE=5
NAS_DB_MAX_OVERFLOW=10
NAS_DB_ECHO=false

# ── Network access control ────────────────────────────────────────────────────
# Comma-separated IPs/CIDRs allowed to reach /api/v1. Health probes are exempt.
# Empty = allow any, permitted ONLY in local/test; the service refuses to start
# in staging/production without an allowlist.
# Example for staging: NAS_ALLOWED_IP_RANGES=10.20.30.40/32,10.20.31.0/24
NAS_ALLOWED_IP_RANGES=

# Set true ONLY when behind a reverse proxy you control that sets
# X-Forwarded-For. When false, forwarding headers are ignored entirely so a
# caller cannot spoof its source address past the allowlist.
NAS_TRUST_PROXY_HEADERS=false

# ── API surface ───────────────────────────────────────────────────────────────
# Swagger UI at /docs. Consider false in production.
NAS_DOCS_ENABLED=true
# Comma-separated browser origins. Leave empty — the Django CRM calls this
# server-to-server and needs no CORS.
NAS_CORS_ALLOW_ORIGINS=

# ── Device credentials ────────────────────────────────────────────────────────
# Path to the 0600-mode YAML file holding switch credentials. Switch secrets are
# NEVER stored in the database; the switches table holds only a credential name.
#   cp credentials.example.yaml credentials.yaml && chmod 600 credentials.yaml
NAS_CREDENTIALS_FILE=credentials.yaml
